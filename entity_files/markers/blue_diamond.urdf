<?xml version="1.0"?>
<robot name="debug_cube">
	<material name="green">
		<color rgba="0 0 1 1"/>
	</material>

	<link name="cube_obj">
		<contact>
			<lateral_friction value="1"/>
		</contact>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0"/>
			<inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
		</inertial>

		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>

			<geometry>
				<box size="0.2 0.2 0.2" />
			</geometry>

			<material name="green"/>
		</visual>
	</link>
</robot>
