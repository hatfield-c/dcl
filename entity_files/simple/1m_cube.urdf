<?xml version="1.0"?>
<robot name="1m_cube">
	<material name="grey">
		<color rgba="0.5 0.5 0.5 1"/>
	</material>

	<link name="cube_obj">
		<contact>
			<lateral_friction value="1"/>
		</contact>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="1"/>
			<inertia ixx="1" ixy="1" ixz="1" iyy="1" iyz="1" izz="1"/>
		</inertial>

		<visual>
			<origin rpy="0 0 0" xyz="0 0 0"/>

			<geometry>
				<box size="0.1 0.1 0.1" />
			</geometry>

			<material name="grey"/>
		</visual>

		<collision>
			<origin rpy="0 0 0" xyz="0 0 0"/>

			<geometry>
				<box size="0.1 0.1 0.1" />
			</geometry>
		</collision>
	</link>
</robot>
