<?xml version="1.0"?>
<robot name="debug_cube">
	<material name="blue">
		<color rgba="0 0 1 1"/>
	</material>

	<link name="cube_obj">
		<contact>
			<lateral_friction value="1"/>
		</contact>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0"/>
			<inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
		</inertial>

		<visual name="bottom">
			<origin rpy="0 0 0" xyz="0 0 -0.15"/>
			<geometry>
				<box size="0.3 0.05 0.05" />
			</geometry>
			<material name="blue"/>
		</visual>

		<visual name="top">
			<origin rpy="0 0 0" xyz="0 0 0.15"/>
			<geometry>
				<box size="0.3 0.05 0.05" />
			</geometry>
			<material name="blue"/>
		</visual>

		<visual name="right">
			<origin rpy="0 0 0" xyz="0.15 0 0"/>
			<geometry>
				<box size="0.05 0.05 0.3" />
			</geometry>
			<material name="blue"/>
		</visual>

		<visual name="left">
			<origin rpy="0 0 0" xyz="-0.15 0 0"/>
			<geometry>
				<box size="0.05 0.05 0.3" />
			</geometry>
			<material name="blue"/>
		</visual>

		<collision name = "bottom_collision">
			<origin rpy="0 0 0" xyz="0 0 -0.15"/>

			<geometry>
				<box size="0.3 0.05 0.05" />
			</geometry>
		</collision>

		<collision name = "top_collision">
			<origin rpy="0 0 0" xyz="0 0 0.15"/>

			<geometry>
				<box size="0.3 0.05 0.05" />
			</geometry>
		</collision>

		<collision name = "right_collision">
			<origin rpy="0 0 0" xyz="0.15 0 0"/>

			<geometry>
				<box size="0.05 0.05 0.3" />
			</geometry>
		</collision>

		<collision name = "left_collision">
			<origin rpy="0 0 0" xyz="-0.15 0 0"/>

			<geometry>
				<box size="0.05 0.05 0.3" />
			</geometry>
		</collision>
	</link>
</robot>
