<?xml version="1.0"?>
<robot name="target_pole">
	<material name="red">
		<color rgba="1 0 0 1"/>
	</material>

	<link name="pole_obj">
		<contact>
			<lateral_friction value="1"/>
		</contact>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value="0"/>
			<inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
		</inertial>

		<visual>
			<origin rpy="0 0 0" xyz="0 0 1.25"/>

			<geometry>
				<box size="0.1 0.1 2.5" />
			</geometry>

			<material name="blue"/>
		</visual>

		<collision>
			<origin rpy="0 0 0" xyz="0 0 1.25"/>

			<geometry>
				<box size="0.1 0.1 2.5" />
			</geometry>
		</collision>
	</link>
</robot>
