<?xml version="1.0"?>
<robot name="20m_floor_t">
	<material name="grey">
		<color rgba="0.5 0.5 0.5 1"/>
	</material>

	<link name="20m_floor_obj">
		<contact>
			<lateral_friction value="1"/>
		</contact>

		<inertial>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<mass value=".0"/>
			<inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
		</inertial>

		<visual>
			<origin rpy="0 0 0" xyz="0 0 -5"/>

			<geometry>
				<box size="20 20 10" />
			</geometry>

			<material name="grey"/>
		</visual>

		<collision>
			<origin rpy="0 0 0" xyz="0 0 -5"/>

			<geometry>
				<box size="20 20 10" />
			</geometry>
		</collision>
	</link>
</robot>